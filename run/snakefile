def check_file_exist(wc, column:str):
    #check if the file exist for certain filetype (HLA_allele, RNA_cram_path, ects)
    val = df.loc[wc.patient_id, column]

    if pd.isna(val):
        return []
    s = str(val).strip()

    if s =="" or s.lower() in ("none", "nan"):
        return []
    
    return s



